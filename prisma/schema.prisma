generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ticket {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  title       String
  category    String
  priority    String
  description String
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}